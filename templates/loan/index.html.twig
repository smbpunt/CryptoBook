{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Emprunts{% endblock %}

{% block body %}
    <twig:App:PageHeader title="Mes emprunts" description="Emprunt total : {{ total|number_format(0, '.', ' ') }} $">
        <twig:Button as="a" href="{{ path('app_loan_new') }}">
            <twig:ux:icon name="lucide:plus" data-icon="inline-start"/> Ajouter un emprunt
        </twig:Button>
    </twig:App:PageHeader>

    <twig:App:InfoDialog>
        <twig:Table>
            <twig:Table:Header>
                <twig:Table:Row>
                    <twig:Table:Head class="w-10"/>
                    <twig:Table:Head>Blockchain</twig:Table:Head>
                    <twig:Table:Head>Dapp</twig:Table:Head>
                    <twig:Table:Head class="text-end">Coin</twig:Table:Head>
                    <twig:Table:Head class="text-end">Valeur ($)</twig:Table:Head>
                    <twig:Table:Head class="text-end">Actions</twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {% for loan in loans %}
                    {% set dapp = loan.dapp %}
                    <twig:Table:Row>
                        <twig:Table:Cell>
                            <twig:App:InfoButton url="{{ path('app_loan_ajax_infos', {id: loan.id}) }}"/>
                        </twig:Table:Cell>
                        <twig:Table:Cell>{{ dapp is not null and dapp.blockchain is not null ? dapp.blockchain }}</twig:Table:Cell>
                        <twig:Table:Cell>
                            {% if dapp is not null and dapp.url is not empty %}
                                <a class="underline-offset-4 hover:underline" href="{{ dapp.url }}">{{ dapp }}</a>
                            {% elseif dapp is not null %}
                                {{ dapp }}
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell class="text-end tabular-nums">{{ loan.nbCoins }} {{ loan.coin.symbol|upper }}</twig:Table:Cell>
                        <twig:Table:Cell class="text-end tabular-nums">{{ loan.currentValue|number_format(2, '.', ' ') }} $</twig:Table:Cell>
                        <twig:Table:Cell class="text-end">
                            <twig:App:RowActions
                                editUrl="{{ path('app_loan_edit', {id: loan.id}) }}"
                                deleteUrl="{{ path('app_loan_delete', {id: loan.id}) }}"
                                tokenId="delete{{ loan.id }}"
                            />
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% else %}
                    <twig:Table:Row>
                        <twig:Table:Cell colspan="6" class="py-6 text-center text-muted-foreground">Aucun emprunt.</twig:Table:Cell>
                    </twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    </twig:App:InfoDialog>
{% endblock %}

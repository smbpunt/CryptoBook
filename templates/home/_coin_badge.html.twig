{# Letter badge of an example coin: no request to a third party for a logo. #}
<span class="inline-flex {{ size }} shrink-0 items-center justify-center rounded-full {{ size == 'size-6' ? 'text-[11px]' : 'text-xs' }} font-bold {{ coin.dark ? 'text-black' : 'text-white' }}" style="background: {{ coin.color }}">{{ coin.letter }}</span>

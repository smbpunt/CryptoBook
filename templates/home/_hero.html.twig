<section aria-labelledby="home-title" class="pt-[clamp(2rem,6vw,5.25rem)]">
    <h1 id="home-title" class="font-display text-[clamp(2.375rem,5.6vw,5rem)] leading-[1.04] font-semibold tracking-[-0.045em]">Ce que valent vos cryptos.<br>Ce qu'elles vous ont coûté.</h1>
    <p class="mt-7 max-w-[600px] text-[clamp(1.0625rem,1.4vw,1.25rem)] leading-[1.55] text-muted-foreground">CryptoBook suit vos positions, vos dépôts en euros ou en dollars et l'évolution de votre portefeuille, heure par heure.</p>
    <div class="mt-9 flex flex-wrap gap-3">
        <twig:Button as="a" href="{{ path('app_register') }}" class="h-13 gap-2.5 px-6.5 text-base max-[37.5rem]:flex-auto">Créer un compte<twig:ux:icon name="lucide:arrow-right"/></twig:Button>
    </div>

    <twig:Card role="img" aria-label="Aperçu du tableau de bord : valeur totale du wallet de 42 618,40 €, en hausse de 3,2 % sur 30 jours, avec la courbe de valeur comparée au montant investi." class="mt-[clamp(3.5rem,6vw,5.25rem)] gap-0 p-[clamp(1.25rem,2.4vw,2rem)]">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <p class="text-sm font-medium text-muted-foreground">Valeur totale du wallet</p>
                <p class="mt-1.5 font-display text-[clamp(2.25rem,4vw,3.375rem)] leading-[1.05] font-semibold tracking-[-0.04em] tabular-nums">{{ 42618.40|amount('€', 2) }}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2.5">
                    <twig:App:Delta :value="3.2"/>
                    <span class="font-medium text-positive tabular-nums">{{ 1318.20|signed_amount('€', 2) }}</span>
                    <span class="text-muted-foreground">sur 30 jours</span>
                </div>
            </div>
            <div class="flex flex-wrap gap-0.5 rounded-full bg-muted p-1">
                {% for label in ['7 j', '30 j', '90 j', '1 an', 'Tout'] %}
                    <span {% if label == '30 j' %}aria-current="true"{% endif %} class="inline-flex min-h-9 items-center rounded-full px-3.5 text-[13px] font-medium text-muted-foreground aria-[current]:bg-popover aria-[current]:text-foreground aria-[current]:shadow-[0_1px_2px_rgba(0,0,0,.08),0_0_0_1px_var(--border)]">{{ label }}</span>
                {% endfor %}
            </div>
        </div>

        <div class="relative mt-7 h-[clamp(12.5rem,22vw,18.75rem)]">
            {% for top in ['top-[8%]', 'top-[36%]', 'top-[64%]', 'top-[92%]'] %}
                <div class="absolute inset-x-0 {{ top }} border-t border-dashed border-border"></div>
            {% endfor %}
            <svg viewBox="0 0 1000 260" preserveAspectRatio="none" class="absolute inset-0 size-full overflow-visible">
                <defs>
                    <linearGradient id="home-chart-area" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" style="stop-color: var(--chart-1); stop-opacity: 0.24"/>
                        <stop offset="1" style="stop-color: var(--chart-1); stop-opacity: 0"/>
                    </linearGradient>
                </defs>
                <path d="M0,188 L40,182 80,186 120,170 160,176 200,158 240,164 280,150 320,156 360,138 400,146 440,128 480,134 520,140 560,122 600,112 640,120 680,100 720,108 760,92 800,98 840,80 880,88 920,70 960,74 1000,58 L1000,260 L0,260 Z" fill="url(#home-chart-area)"/>
                <path d="M0,226 L250,226 250,220 520,220 520,214 760,214 760,206 1000,206" class="fill-none stroke-muted-foreground" stroke-width="1.5" stroke-dasharray="5 5" vector-effect="non-scaling-stroke"/>
                <path d="M0,188 L40,182 80,186 120,170 160,176 200,158 240,164 280,150 320,156 360,138 400,146 440,128 480,134 520,140 560,122 600,112 640,120 680,100 720,108 760,92 800,98 840,80 880,88 920,70 960,74 1000,58" class="fill-none stroke-chart-1" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
            </svg>
            <div class="absolute top-[22.3%] -right-[5px] -mt-[5px] size-2.5 rounded-full bg-chart-1 shadow-[0_0_0_2px_var(--popover)]"></div>
        </div>

        <div class="mt-[18px] flex flex-wrap gap-x-5 gap-y-2 border-t border-border pt-3.5 text-[13px] text-muted-foreground">
            <span class="inline-flex items-center gap-2"><span class="w-[18px] rounded-xs border-t-[2.5px] border-chart-1"></span>Valeur du wallet (snapshots horaires)</span>
            <span class="inline-flex items-center gap-2"><span class="w-[18px] border-t-[1.5px] border-dashed border-muted-foreground"></span>Investi (dépôts cumulés)</span>
        </div>
    </twig:Card>
</section>

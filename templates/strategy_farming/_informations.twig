<div class="grid gap-1 text-sm">
    {% if farming.enteredAt %}<p>Depuis le : {{ farming.enteredAt|date('d/m/Y') }}</p>{% endif %}
    <p>{{ farming.nbCoins }} {{ farming.coin.symbol|upper }} (~{{ farming.valueUsd|round(2)|number_format(2, '.', ' ') }} $)</p>
    <p>APR : {{ farming.apr }} %</p>
    {% if farming.description is not empty %}<p>Description : {{ farming.description }}</p>{% endif %}
    <p><a class="underline underline-offset-4" href="{{ farming.dapp.url }}">{{ farming.dapp }}</a> sur {{ farming.dapp.blockchain }}</p>
</div>
<h3 class="mt-2 font-medium">Gains</h3>
<div class="grid grid-cols-2 gap-1 text-sm sm:grid-cols-4">
    <p>Annuel : ~{{ farming.annualRewardsUsd|round(2)|number_format(2, '.', ' ') }} $</p>
    <p>Mensuel : ~{{ (farming.annualRewardsUsd/12)|round(2)|number_format(2, '.', ' ') }} $</p>
    <p>Hebdo : ~{{ (farming.annualRewardsUsd/52)|round(2)|number_format(2, '.', ' ') }} $</p>
    <p>Journalier : ~{{ (farming.annualRewardsUsd/365)|round(2)|number_format(2, '.', ' ') }} $</p>
</div>

{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Nouveau mot de passe">
        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}
            <twig:Button type="submit" class="w-full">Reset password</twig:Button>
        {{ form_end(resetForm) }}
    </twig:App:AuthCard>
{% endblock %}

{%- props
    ## 'default'|'sm' Size variant of the card.
    size = 'default'
-%}
<div
    data-slot="card"
    data-size="{{ size }}"
    {{ attributes.defaults({
        class: 'group/card flex flex-col gap-(--card-spacing) overflow-hidden rounded-[22px] border border-border bg-card py-(--card-spacing) text-sm text-card-foreground shadow-(--shadow-card) backdrop-blur-lg [--card-spacing:--spacing(5)] md:[--card-spacing:--spacing(6)] has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(4)] data-[size=sm]:has-data-[slot=card-footer]:pb-0 *:[img:first-child]:rounded-t-[22px] *:[img:last-child]:rounded-b-[22px]'|tailwind_classes,
    }) }}
>
    {##- The card content, typically includes `Card:Header`, `Card:Content`, and/or `Card:Footer`. -#}
    {%- block content %}{% endblock -%}
</div>

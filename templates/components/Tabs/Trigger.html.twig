{%- props
    ## string Unique suffix identifier for generating Tabs internal IDs.
    value
-%}
{%- set _tabs_defaultValue = inject('tabs.defaultValue', '') -%}

{%- set _tab_id = 'tab-' ~ value -%}
{%- set _tab_content_id = _tab_id ~ '-description' -%}
{%- set open = _tabs_defaultValue is same as(value) -%}
<button
    id="{{ _tab_id }}"
    data-slot="tabs-trigger"
    data-tabs-target="trigger"
    data-tab-id="{{ value }}"
    role="tab"
    aria-controls="{{ _tab_content_id }}"
    aria-selected="{{ open ? 'true' : 'false' }}"
    {{ open ? 'data-active' }}
    {{ attributes.defaults({
        class: ('relative inline-flex min-h-10 min-w-11 flex-1 items-center justify-center gap-1.5 rounded-full border border-transparent px-3.5 text-[13px] font-medium whitespace-nowrap text-muted-foreground transition-all group-data-[orientation=vertical]/tabs:w-full group-data-[orientation=vertical]/tabs:justify-start hover:text-foreground outline-none focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 has-data-[icon=inline-end]:pe-1 has-data-[icon=inline-start]:ps-1 group-data-[variant=default]/tabs-list:data-active:shadow-[0_1px_2px_rgba(0,0,0,.08),0_0_0_1px_var(--border)] group-data-[variant=line]/tabs-list:data-active:shadow-none [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*=\'size-\'])]:size-4 group-data-[variant=line]/tabs-list:bg-transparent group-data-[variant=line]/tabs-list:data-active:bg-transparent dark:group-data-[variant=line]/tabs-list:data-active:border-transparent dark:group-data-[variant=line]/tabs-list:data-active:bg-transparent data-active:bg-popover data-active:text-foreground after:absolute after:bg-foreground after:opacity-0 after:transition-opacity group-data-[orientation=horizontal]/tabs:after:inset-x-0 group-data-[orientation=horizontal]/tabs:after:bottom-[-5px] group-data-[orientation=horizontal]/tabs:after:h-0.5 group-data-[orientation=vertical]/tabs:after:inset-y-0 group-data-[orientation=vertical]/tabs:after:-end-1 group-data-[orientation=vertical]/tabs:after:w-0.5 group-data-[variant=line]/tabs-list:data-active:after:opacity-100 ')|tailwind_classes,
        'data-action': 'click->tabs#open',
        type: 'button',
    }) }}
>
    {##- The default block. -#}
    {%- block content -%}{%- endblock -%}
</button>

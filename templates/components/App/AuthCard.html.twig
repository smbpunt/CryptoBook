{%- props
    ## string Card title, also the page title.
    title,
    ## string|null Optional description under the title.
    description = null
-%}
{%- set _content -%}{%- block content %}{% endblock -%}{%- endset -%}
<div class="flex min-h-[70vh] items-center justify-center">
    <twig:Card {{ ...attributes.defaults({class: 'w-full max-w-sm'}) }}>
        <twig:Card:Header class="items-center text-center">
            <twig:App:Logo label="CryptoBook" class="mx-auto mb-4"/>
            <h1 class="font-display text-2xl leading-[1.1] font-semibold tracking-[-0.03em]">{{ title }}</h1>
            {% if description %}<twig:Card:Description>{{ description }}</twig:Card:Description>{% endif %}
        </twig:Card:Header>
        <twig:Card:Content>
            {{ _content }}
        </twig:Card:Content>
    </twig:Card>
</div>

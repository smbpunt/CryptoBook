{%- props
    ## string The page title.
    title,
    ## string|null Optional subtitle below the title.
    description = null
-%}
<div {{ attributes.defaults({class: 'mb-6 flex flex-wrap items-end justify-between gap-4'|tailwind_classes}) }}>
    <div class="grid gap-1">
        <h1 class="text-2xl font-semibold tracking-tight">{{ title }}</h1>
        {% if description %}<p class="text-sm text-muted-foreground">{{ description }}</p>{% endif %}
    </div>
    {##- Page actions (buttons, links). -#}
    <div class="flex flex-wrap items-center gap-2">{% block content %}{% endblock %}</div>
</div>

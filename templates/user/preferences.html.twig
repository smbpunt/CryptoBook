{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Préférences{% endblock %}

{% block body %}
    <twig:App:PageHeader title="Préférences"/>

    <twig:Card class="max-w-md">
        <twig:Card:Content>
            {{ form_start(form) }}
                {{ form_row(form.favoriteFiatCurrency, {label: 'Monnaie FIAT préférée'}) }}
                <twig:Button type="submit">{{ button_label|default('Enregistrer') }}</twig:Button>
            {{ form_end(form) }}
        </twig:Card:Content>
    </twig:Card>
{% endblock %}

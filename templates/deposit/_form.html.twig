{{ form_start(form) }}
    <div class="grid gap-x-4 md:grid-cols-2">
        {{ form_row(form.depositedAt, {label: 'Déposé le'}) }}
        {{ form_row(form.exchange, {label: 'Sur'}) }}
    </div>
    <div class="grid gap-x-4 md:grid-cols-2">
        <twig:Form:Item class="mb-4">
            {{ form_label(form.amount, 'Montant') }}
            <div class="flex gap-2">
                {{ form_widget(form.amount, {attr: {placeholder: 'ex: 150'}}) }}
                {{ form_widget(form.fiatCurrency, {attr: {class: 'w-28 shrink-0'}}) }}
            </div>
            {{ form_errors(form.amount) }}
            {{ form_errors(form.fiatCurrency) }}
        </twig:Form:Item>
        {{ form_row(form.type, {label: 'Type'}) }}
    </div>
    <twig:Button type="submit" class="h-11 px-5">{{ button_label|default('Enregistrer') }}</twig:Button>
{{ form_end(form) }}

{% extends 'base.html.twig' %}

{% block title %}Dépôts{% endblock %}

{% block body %}
    <twig:App:PageHeader title="Dépôts">
        <twig:Button as="a" href="{{ path('app_deposit_new') }}" class="h-11 px-4">
            <twig:ux:icon name="lucide:plus"/>Nouveau dépôt
        </twig:Button>
    </twig:App:PageHeader>

    {% set symbol = favoriteCurrency.symbol %}
    {# Sorted by date, undated last. #}
    {% set lastDepositAt = deposits|map(deposit => deposit.depositedAt)|filter(date => date is not null)|last %}
    <div class="mb-5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-5 lg:max-w-[calc(50%-10px)]">
        <twig:App:Stat label="Total déposé" icon="lucide:coins" hint="{{ symbol != '$' ? 'soit ' ~ totalUsd|amount('$') }}">
            {{- totalFavorite|amount(symbol) -}}
        </twig:App:Stat>
        <twig:App:Stat label="Dépôts" icon="lucide:list" hint="{{ lastDepositAt ? 'dernier le ' ~ lastDepositAt|day }}">
            {{- deposits|length -}}
        </twig:App:Stat>
    </div>

    <twig:App:ListCard title="Historique" titleId="deposit-list">
        <twig:Table>
            <twig:Table:Header>
                <twig:Table:Row>
                    <twig:Table:Head>Date</twig:Table:Head>
                    <twig:Table:Head class="text-end">Montant</twig:Table:Head>
                    <twig:Table:Head>Plateforme</twig:Table:Head>
                    <twig:Table:Head>Moyen</twig:Table:Head>
                    <twig:Table:Head><span class="sr-only">Actions</span></twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {% for deposit in deposits %}
                    <twig:Table:Row>
                        <twig:Table:Cell class="text-muted-foreground">{{ deposit.depositedAt ? deposit.depositedAt|day : '—' }}</twig:Table:Cell>
                        <twig:Table:Cell class="text-end font-semibold">{{ deposit.amount|amount(deposit.fiatCurrency.symbol) }}</twig:Table:Cell>
                        <twig:Table:Cell>
                            {% if deposit.exchange is not null and deposit.exchange.url is not empty %}
                                <a class="underline-offset-4 hover:underline" target="_blank" rel="noopener" href="{{ deposit.exchange.url }}">{{ deposit.exchange }}</a>
                            {% else %}
                                {{ deposit.exchange }}
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell class="text-muted-foreground">{{ deposit.type }}</twig:Table:Cell>
                        <twig:Table:Cell class="w-px text-end">
                            <twig:App:RowActions
                                editUrl="{{ path('app_deposit_edit', {id: deposit.id}) }}"
                                deleteUrl="{{ path('app_deposit_delete', {id: deposit.id}) }}"
                                tokenId="delete{{ deposit.id }}"
                            />
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% else %}
                    <twig:Table:Row>
                        <twig:Table:Cell colspan="5" class="py-6 text-center text-muted-foreground">Aucun dépôt.</twig:Table:Cell>
                    </twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    </twig:App:ListCard>
{% endblock %}

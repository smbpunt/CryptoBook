{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Veuillez vous inscrire">
        {% for flashError in app.flashes('verify_email_error') %}
            <twig:Alert variant="destructive" class="mb-4">
                <twig:Alert:Description>{{ flashError }}</twig:Alert:Description>
            </twig:Alert>
        {% endfor %}

        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.plainPassword, {label: 'Mot de passe'}) }}
            {{ form_row(registrationForm.agreeTerms) }}

            <twig:Alert class="mb-4">
                <twig:ux:icon name="lucide:mail-warning"/>
                <twig:Alert:Description>
                    Vous allez recevoir un mail d'une adresse gmail pour vérifier votre adresse : pensez à regarder dans vos indésirables.
                </twig:Alert:Description>
            </twig:Alert>

            <twig:Button type="submit" class="w-full">Register</twig:Button>
        {{ form_end(registrationForm) }}
    </twig:App:AuthCard>
{% endblock %}

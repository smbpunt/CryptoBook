{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Nouveau mot de passe" description="Choisissez le mot de passe de votre compte.">
        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}
            <twig:Button type="submit" class="h-11 w-full">Enregistrer</twig:Button>
        {{ form_end(resetForm) }}
    </twig:App:AuthCard>
{% endblock %}

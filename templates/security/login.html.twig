{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Connexion" description="Accédez à votre portefeuille.">
        <twig:Form method="post" class="space-y-4">
            {% if error %}
                <twig:Alert variant="destructive">
                    <twig:ux:icon name="lucide:circle-alert"/>
                    <twig:Alert:Title>{{ error.messageKey|trans(error.messageData, 'security') }}</twig:Alert:Title>
                </twig:Alert>
            {% endif %}
            {% if app.user %}
                <p class="text-sm text-muted-foreground">
                    Connecté en tant que {{ app.user.userIdentifier }}, <a class="underline" href="{{ path('app_logout') }}" data-turbo="false">se déconnecter</a>
                </p>
            {% endif %}

            <twig:Form:Item>
                <twig:Form:Label for="inputEmail">Email</twig:Form:Label>
                <twig:Input type="email" id="inputEmail" name="email" value="{{ last_username }}" autocomplete="email" placeholder="name@example.com" required autofocus/>
            </twig:Form:Item>
            <twig:Form:Item>
                <twig:Form:Label for="inputPassword">Mot de passe</twig:Form:Label>
                <twig:Input type="password" id="inputPassword" name="password" autocomplete="current-password" required/>
                <a href="{{ path('app_forgot_password_request') }}" class="justify-self-end text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Mot de passe oublié ?</a>
            </twig:Form:Item>
            <div class="flex items-center gap-2">
                <twig:Checkbox id="remember_me" name="_remember_me"/>
                <twig:Label for="remember_me">Rester connecté</twig:Label>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <twig:Button type="submit" class="h-11 w-full">Se connecter</twig:Button>
            <p class="text-center text-sm text-muted-foreground">
                Pas de compte ? <a href="{{ path('app_register') }}" class="underline underline-offset-4">S'inscrire</a>
            </p>
        </twig:Form>
    </twig:App:AuthCard>
{% endblock %}

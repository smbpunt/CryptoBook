{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Mot de passe oublié" description="Recevez un lien pour choisir un nouveau mot de passe.">
        {% for flash_error in app.flashes('reset_password_error') %}
            <twig:Alert variant="destructive" class="mb-4">
                <twig:Alert:Description>{{ flash_error }}</twig:Alert:Description>
            </twig:Alert>
        {% endfor %}
        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email, {label: 'Email'}) }}
            <twig:Button type="submit" class="h-11 w-full">Recevoir le lien</twig:Button>
        {{ form_end(requestForm) }}
    </twig:App:AuthCard>
{% endblock %}

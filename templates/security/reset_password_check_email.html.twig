{% extends 'base.html.twig' %}

{% block title %}Email de réinitialisation envoyé{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Email envoyé">
        <div class="grid gap-3 text-sm text-muted-foreground">
            <p>
                If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password.
                This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
            </p>
            <p>If you don't receive an email please check your spam folder or <a class="text-foreground underline" href="{{ path('app_forgot_password_request') }}">try again</a>.</p>
        </div>
    </twig:App:AuthCard>
{% endblock %}

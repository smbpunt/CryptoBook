{% extends 'base.html.twig' %}

{% block title %}Email envoyé{% endblock %}

{% block body %}
    <twig:App:AuthCard title="Email envoyé">
        <div class="grid gap-3 text-center text-sm text-muted-foreground">
            <p>
                Si un compte correspond à cette adresse, un email vient de lui être envoyé avec un lien pour changer le mot de passe.
                Ce lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle', 'fr') }}.
            </p>
            <p>Rien reçu ? Vérifiez vos spams ou <a class="text-foreground underline underline-offset-4" href="{{ path('app_forgot_password_request') }}">recommencez</a>.</p>
        </div>
    </twig:App:AuthCard>
{% endblock %}

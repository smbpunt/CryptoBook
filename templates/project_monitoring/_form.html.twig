{% import _self as formMacros %}

{% macro links_prototype(link) %}
    <tr class="border-b">
        <td class="w-12 p-2"><twig:Button variant="outline" size="icon-sm" data-action="collection#remove" aria-label="Retirer"><twig:ux:icon name="lucide:minus"/></twig:Button></td>
        <td class="p-2">{{ form_widget(link) }}</td>
    </tr>
{% endmacro %}

{{ form_start(form) }}
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <div class="grid gap-x-4 md:grid-cols-3">
                {{ form_row(form.libelle, {label: 'Nom du projet'}) }}
                {{ form_row(form.type, {label: 'Type de projet'}) }}
                {{ form_row(form.coin, {label: 'Lié à la cryptomonnaie'}) }}
            </div>
            {{ form_row(form.description, {label: 'Description du projet', attr: {rows: 6}}) }}
            {{ form_row(form.note, {label: 'Note perso', attr: {rows: 6}}) }}
        </div>
        <div>
            <div data-controller="collection"
                 data-collection-index-value="{{ form.links is empty ? 0 : max(form.links.children|keys) + 1 }}"
                 data-collection-prototype-value="{{ formMacros.links_prototype(form.links.vars.prototype)|e('html_attr') }}">
                <twig:Button variant="outline" class="mb-2" data-action="collection#add">
                    <twig:ux:icon name="lucide:plus" data-icon="inline-start"/> Ajouter un lien
                </twig:Button>
                <table class="w-full text-sm">
                    <tbody data-collection-target="items">
                    {% for link in form.links %}
                        {{ formMacros.links_prototype(link) }}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <twig:Button type="submit" class="mt-4">{{ button_label|default('Save') }}</twig:Button>
{{ form_end(form) }}

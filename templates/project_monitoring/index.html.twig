{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block body %}
    <twig:App:PageHeader title="Projets">
        <twig:Button as="a" href="{{ path('app_project_monitoring_new') }}" class="h-11 px-4">
            <twig:ux:icon name="lucide:plus"/>Nouveau projet
        </twig:Button>
    </twig:App:PageHeader>

    <twig:App:ListCard title="Projets à suivre" titleId="project-list">
        <twig:Table>
            <twig:Table:Header>
                <twig:Table:Row>
                    <twig:Table:Head>Projet</twig:Table:Head>
                    <twig:Table:Head>Crypto</twig:Table:Head>
                    <twig:Table:Head>Liens</twig:Table:Head>
                    <twig:Table:Head><span class="sr-only">Actions</span></twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {% for project_monitoring in project_monitorings %}
                    {% set coin = project_monitoring.coin %}
                    <twig:Table:Row>
                        <twig:Table:Cell class="font-semibold">{{ project_monitoring.libelle }}</twig:Table:Cell>
                        <twig:Table:Cell>
                            {% if coin %}
                                <span class="flex items-center gap-2.5">
                                    <twig:App:CoinLogo url="{{ coin.urlImgThumb }}" name="{{ coin.libelle }}" class="size-7"/>
                                    <span>{{ coin }}</span>
                                </span>
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell class="whitespace-normal">
                            <ul class="grid gap-1">
                                {% for link in project_monitoring.links %}
                                    <li><a class="break-all text-muted-foreground underline-offset-4 hover:text-foreground hover:underline" target="_blank" rel="noopener" href="{{ link }}">{{ link }}</a></li>
                                {% endfor %}
                            </ul>
                        </twig:Table:Cell>
                        <twig:Table:Cell class="w-px text-end">
                            <twig:App:RowActions
                                editUrl="{{ path('app_project_monitoring_edit', {id: project_monitoring.id}) }}"
                                deleteUrl="{{ path('app_project_monitoring_delete', {id: project_monitoring.id}) }}"
                                tokenId="delete{{ project_monitoring.id }}"
                            />
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% else %}
                    <twig:Table:Row><twig:Table:Cell colspan="4" class="py-6 text-center text-muted-foreground">Aucun projet.</twig:Table:Cell></twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    </twig:App:ListCard>
{% endblock %}

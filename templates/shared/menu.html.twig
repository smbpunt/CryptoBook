{% extends 'knp_menu_base.html.twig' %}

{#
 # Main navigation: one level, rendered as pills. The row scrolls horizontally on narrow screens.
 #}
{% block root %}
    <ul class="flex gap-0.5 whitespace-nowrap">
        {% for item in item.children|filter(item => item.displayed) %}
            {% set current = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) %}
            <li>
                <a
                    href="{{ item.uri }}"
                    {% if current %}aria-current="page"{% endif %}
                    class="{{ html_classes('inline-flex min-h-11 items-center rounded-full px-3.5 text-sm font-medium transition-colors outline-none focus-visible:ring-3 focus-visible:ring-ring/50', {
                        'bg-popover text-foreground ring-1 ring-border': current,
                        'text-muted-foreground hover:bg-muted hover:text-foreground': not current,
                    }) }}"
                >{{ item.label }}</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

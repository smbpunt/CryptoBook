{% extends 'knp_menu_base.html.twig' %}

{#
 # Flat navigation (one level) rendered with the shadcn Button component.
 # `options.direction` switches between the desktop row and the mobile column.
 #}
{% block root %}
    {% set vertical = options.direction|default('row') == 'column' %}
    <ul class="{{ vertical ? 'flex flex-col gap-1' : 'flex flex-wrap items-center gap-1' }}">
        {% for item in item.children|filter(item => item.displayed) %}
            {% set current = matcher.isCurrent(item) or matcher.isAncestor(item, options.matchingDepth) %}
            <li>
                <twig:Button
                    as="a"
                    variant="ghost"
                    href="{{ item.uri }}"
                    aria-current="{{ current ? 'page' : false }}"
                    class="{{ html_classes({'w-full justify-start': vertical, 'bg-muted text-foreground': current, 'text-muted-foreground': not current}) }}"
                >{{ item.label }}</twig:Button>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

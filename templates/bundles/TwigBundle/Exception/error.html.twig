{% extends 'base.html.twig' %}

{#
    Single template for every HTML error status (Symfony falls back to error.html.twig).
    The main menu is hidden: security is not available on 404 pages, and a 5xx may come from the database.
    Never print exception.message here, it carries internal details.
#}
{% set pages = {
    403: {icon: 'lucide:shield-x', title: 'Accès refusé', text: "Vous n'avez pas les droits pour accéder à cette page."},
    404: {icon: 'lucide:search-x', title: 'Page introuvable', text: "Cette page n'existe pas ou a été déplacée."},
    429: {icon: 'lucide:timer', title: 'Trop de requêtes', text: 'Patientez quelques instants avant de réessayer.'},
    500: {icon: 'lucide:server-crash', title: 'Erreur serveur', text: "Une erreur inattendue s'est produite. Réessayez dans quelques minutes."},
    503: {icon: 'lucide:construction', title: 'Maintenance en cours', text: 'CryptoBook revient très vite.'},
} %}
{% set page = pages[status_code] ?? (status_code >= 500 ? pages[500] : {
    icon: 'lucide:circle-alert',
    title: status_text,
    text: "La requête n'a pas pu aboutir.",
}) %}

{% block title %}{{ status_code }} · {{ page.title }}{% endblock %}

{% block header_nav %}{% endblock %}
{% block header_account %}{% endblock %}

{% block body %}
    <div class="flex min-h-[70vh] items-center justify-center">
        <twig:Empty class="max-w-md">
            <twig:Empty:Media variant="icon" class="size-12 rounded-xl [&_svg]:size-6">
                <twig:ux:icon name="{{ page.icon }}"/>
            </twig:Empty:Media>
            <twig:Empty:Header>
                <p class="font-display text-6xl font-semibold tracking-[-0.04em] text-muted-foreground/40 tabular-nums">{{ status_code }}</p>
                <h1 class="font-display text-2xl font-semibold tracking-[-0.03em]">{{ page.title }}</h1>
                <twig:Empty:Description>{{ page.text }}</twig:Empty:Description>
            </twig:Empty:Header>
            <twig:Empty:Content>
                <twig:Button as="a" href="{{ path('home') }}">
                    <twig:ux:icon name="lucide:house"/>
                    Retour à l'accueil
                </twig:Button>
            </twig:Empty:Content>
        </twig:Empty>
    </div>
{% endblock %}

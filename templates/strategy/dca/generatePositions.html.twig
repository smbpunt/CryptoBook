{% extends 'base.html.twig' %}

{% block title %}Générer les positions DCA{% endblock %}

{% block body %}
    <twig:App:PageHeader title="Générer les positions DCA"/>

    {{ form_start(form_dca) }}
        <div class="grid gap-4">
            {% for form in form_dca.positions %}
                <twig:Card><twig:Card:Content>
                    {{ include('strategy/dca/_position_form.html.twig') }}
                </twig:Card:Content></twig:Card>
            {% endfor %}
        </div>
        <twig:Button type="submit" class="mt-5 h-11 px-5">{{ button_label|default('Valider') }}</twig:Button>
    {{ form_end(form_dca) }}
{% endblock %}

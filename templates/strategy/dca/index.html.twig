{% extends 'base.html.twig' %}

{% block title %}DCA{% endblock %}

{% block body %}
    {% if dca is not null %}
        <twig:App:PageHeader title="DCA"
                             data-controller="dca"
                             data-dca-generate-url-value="{{ path('app_strategy_dca_generate_positions') }}"
                             data-dca-auto-url-value="{{ path('app_strategy_dca_dcaauto') }}">
            <twig:Dialog id="dca_generate">
                <twig:Dialog:Trigger>
                    <twig:Button class="h-11 px-4" {{ ...dialog_trigger_attrs }}><twig:ux:icon name="lucide:list-plus"/>Générer mes positions</twig:Button>
                </twig:Dialog:Trigger>
                <twig:Dialog:Content>
                    <twig:Dialog:Header>
                        <twig:Dialog:Title>DCA</twig:Dialog:Title>
                        <twig:Dialog:Description>Montant à répartir selon votre allocation.</twig:Dialog:Description>
                    </twig:Dialog:Header>
                    <twig:Form:Item>
                        <twig:Form:Label for="dca_value">Argent investi ($)</twig:Form:Label>
                        <twig:InputGroup>
                            <twig:InputGroup:Input id="dca_value" data-dca-target="amount" required placeholder="ex: 100" value="{{ amountUsd is null ? '' : amountUsd|round(2) }}"/>
                            <twig:InputGroup:Addon align="inline-end">$</twig:InputGroup:Addon>
                        </twig:InputGroup>
                    </twig:Form:Item>
                    <twig:Dialog:Footer>
                        <twig:Button data-action="dca#generate">Valider</twig:Button>
                    </twig:Dialog:Footer>
                </twig:Dialog:Content>
            </twig:Dialog>

            <twig:Dialog id="dca_auto">
                <twig:Dialog:Trigger>
                    <twig:Button variant="outline" class="h-11 px-4" {{ ...dialog_trigger_attrs }}>DCA Auto</twig:Button>
                </twig:Dialog:Trigger>
                <twig:Dialog:Content>
                    <twig:Dialog:Header>
                        <twig:Dialog:Title>DCA Auto</twig:Dialog:Title>
                        <twig:Dialog:Description>Génère des achats récurrents.</twig:Dialog:Description>
                    </twig:Dialog:Header>
                    {{ form_start(form, {attr: {'data-dca-target': 'autoForm'}}) }}
                        {{ form_row(form.coin, {label: 'Crypto'}) }}
                        {{ form_row(form.value, {label: 'Investi au total', addon: '$', attr: {placeholder: 'ex: 200'}}) }}
                        {{ form_row(form.type_recurr, {label: 'Type de récurrence'}) }}
                        {{ form_row(form.nb_recurr, {label: 'Nombre de récurrence', attr: {placeholder: 'ex: 31'}}) }}
                        {{ form_row(form.date_first, {label: 'Date du premier achat'}) }}
                        <twig:Dialog:Footer>
                            <twig:Button data-action="dca#auto">Valider</twig:Button>
                        </twig:Dialog:Footer>
                    {{ form_end(form) }}
                </twig:Dialog:Content>
            </twig:Dialog>

            <twig:Button as="a" variant="outline" href="{{ path('app_strategy_dca_edit') }}" class="h-11 px-4">Modifier</twig:Button>
        </twig:App:PageHeader>

        <div class="mb-5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-5">
            <twig:App:Stat label="Depuis le fiat" icon="lucide:euro">{{ dca.fiatToDcaEur|amount('€', 2) }}</twig:App:Stat>
            <twig:App:Stat label="Depuis le farming" icon="lucide:sprout">{{ dca.farmingToDcaUsd|amount('$', 2) }}</twig:App:Stat>
            <twig:App:Stat label="À investir" icon="lucide:wallet" hint="{{ amountUsd is null ? 'Taux EUR indisponible' : 'au taux EUR du jour' }}">
                {{- amountUsd is null ? '—' : amountUsd|amount('$', 2) -}}
            </twig:App:Stat>
        </div>

        <twig:App:ListCard title="Allocation" titleId="dca-allocation">
            <twig:Table>
                <twig:Table:Header>
                    <twig:Table:Row>
                        <twig:Table:Head>Actif</twig:Table:Head>
                        <twig:Table:Head class="text-end">Part</twig:Table:Head>
                        <twig:Table:Head class="text-end">À investir</twig:Table:Head>
                        <twig:Table:Head class="text-end">Quantité</twig:Table:Head>
                    </twig:Table:Row>
                </twig:Table:Header>
                <twig:Table:Body>
                    {% for part in dca.parts %}
                        {% set amount = amountUsd is null ? null : amountUsd * part.percent / 100 %}
                        <twig:Table:Row>
                            <twig:Table:Cell>
                                <span class="flex items-center gap-2.5">
                                    <twig:App:CoinLogo url="{{ part.coin.urlImgThumb }}" name="{{ part.coin.libelle }}" class="size-7"/>
                                    <span class="font-semibold">{{ part.coin.symbol|upper }}</span>
                                </span>
                            </twig:Table:Cell>
                            <twig:Table:Cell class="text-end text-muted-foreground">{{ part.percent|percent }}</twig:Table:Cell>
                            <twig:Table:Cell class="text-end font-semibold">{{ amount is null ? '—' : amount|amount('$', 2) }}</twig:Table:Cell>
                            <twig:Table:Cell class="text-end">{{ amount is not null and part.coin.priceUsd > 0 ? (amount / part.coin.priceUsd)|quantity : '—' }}</twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row><twig:Table:Cell colspan="4" class="py-6 text-center text-muted-foreground">Aucune allocation.</twig:Table:Cell></twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:App:ListCard>
    {% else %}
        <twig:App:PageHeader title="DCA">
            <twig:Button as="a" href="{{ path('app_strategy_dca_new') }}" class="h-11 px-4"><twig:ux:icon name="lucide:plus"/>Créer mon DCA</twig:Button>
        </twig:App:PageHeader>
        <twig:Empty class="border">
            <twig:Empty:Header>
                <twig:Empty:Media variant="icon"><twig:ux:icon name="lucide:repeat"/></twig:Empty:Media>
                <twig:Empty:Title>Aucune stratégie DCA définie</twig:Empty:Title>
            </twig:Empty:Header>
        </twig:Empty>
    {% endif %}
{% endblock %}

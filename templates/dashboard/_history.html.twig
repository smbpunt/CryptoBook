{# Wallet value over a period. Rendered alone by app_dashboard_history when the period changes: no layout, the frame only. #}
{% set symbol = dashboard.currencySymbol %}
{% set period = history.period %}
{% set startedAt = history.startedAt %}
{% if startedAt is null %}
    {% set periodText = period.description %}
{% elseif not history.coversPeriod or period.value == 'all' %}
    {% set periodText = 'depuis le ' ~ startedAt|format_date(timezone: 'Europe/Paris', pattern: startedAt|date('Y') == 'now'|date('Y') ? 'd MMM' : 'd MMM yyyy', locale: 'fr') %}
{% else %}
    {% set periodText = period.description %}
{% endif %}
<turbo-frame id="wallet-history" class="flex flex-1 flex-col">
    <twig:Card class="flex-1 gap-0 px-6 pt-6 pb-5" aria-labelledby="wallet-history-title">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 id="wallet-history-title" class="text-sm font-medium text-muted-foreground">Valeur totale du wallet</h2>
                <p class="mt-1.5 font-display text-[clamp(2.25rem,7vw,3.375rem)] leading-[1.05] font-semibold tracking-[-0.04em] tabular-nums">{{ dashboard.toFavorite(dashboard.totalUsd)|amount(symbol) }}</p>
                <div class="mt-3 flex flex-wrap items-center gap-2.5 text-sm">
                    {% if not history.isEmpty %}
                        <twig:App:Delta :value="history.changePercent"/>
                        <span class="font-medium tabular-nums {{ history.changeUsd < 0 ? 'text-negative' : 'text-positive' }}">{{ dashboard.toFavorite(history.changeUsd)|signed_amount(symbol) }}</span>
                    {% endif %}
                    <span class="text-muted-foreground">
                        {%- if not history.isEmpty %}{{ periodText }}{% endif -%}
                        {%- if not dashboard.isUsd %}{{ not history.isEmpty ? ' · ' }}soit {{ dashboard.totalUsd|amount('$') }}{% endif -%}
                    </span>
                </div>
            </div>
            <nav aria-label="Période du graphique" class="flex flex-wrap gap-0.5 rounded-full bg-muted p-1">
                {% for item in periods %}
                    <a href="{{ path('app_dashboard_history', {period: item.value}) }}"
                       {% if item == period %}aria-current="true"{% endif %}
                       class="inline-flex min-h-10 min-w-11 items-center justify-center rounded-full px-3.5 text-[13px] font-medium text-muted-foreground outline-none hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring/50 aria-[current]:bg-popover aria-[current]:text-foreground aria-[current]:shadow-[0_1px_2px_rgba(0,0,0,.08),0_0_0_1px_var(--border)]">{{ item.label }}</a>
                {% endfor %}
            </nav>
        </div>

        {% if chart %}
            {% set points = history.points %}
            <div class="relative mt-7 h-[300px]">
                {{ render_chart(chart, {
                    'data-controller': 'wallet-chart',
                    'data-wallet-chart-currency-value': symbol,
                    'data-wallet-chart-unit-value': history.tickUnit,
                    'data-wallet-chart-hourly-value': period.isHourly ? 'true' : 'false',
                    'role': 'img',
                    'aria-label': 'Évolution de la valeur totale du wallet ' ~ periodText ~ ', de ' ~ dashboard.toFavorite(points|first.valueUsd)|amount(symbol) ~ ' à ' ~ dashboard.toFavorite(points|last.valueUsd)|amount(symbol),
                }) }}
            </div>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-border pt-3.5 text-[13px] text-muted-foreground">
                <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="w-4.5 rounded-sm border-t-[2.5px] border-chart-1"></span>Valeur du wallet ({{ period.isHourly ? 'snapshots horaires' : 'dernier snapshot de chaque jour' }})</span>
                {% if chart.data.datasets|length > 1 %}
                    <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="w-4.5 border-t-[1.5px] border-dashed border-muted-foreground"></span>Investi (dépôts cumulés)</span>
                {% endif %}
            </div>
        {% else %}
            <twig:Empty class="mt-6 min-h-[300px] border border-border">
                <twig:Empty:Header>
                    <twig:Empty:Media variant="icon"><twig:ux:icon name="lucide:chart-line"/></twig:Empty:Media>
                    <twig:Empty:Title>Pas encore d’historique</twig:Empty:Title>
                    <twig:Empty:Description>La valeur du wallet est enregistrée chaque heure : la courbe apparaît après le premier snapshot.</twig:Empty:Description>
                </twig:Empty:Header>
            </twig:Empty>
        {% endif %}
    </twig:Card>
</turbo-frame>

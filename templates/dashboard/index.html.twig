{% extends 'base.html.twig' %}

{% block importmap %}{{ importmap(['app', 'home']) }}{% endblock %}

{% block body %}
    {% set fiat = dashboard.currencySymbol %}
    {% set resultatUsd = dashboard.totalUsd - dashboard.depositUsd %}
    {% set percent = dashboard.depositUsd > 0 ? dashboard.totalUsd * 100 / dashboard.depositUsd - 100 : 0 %}

    <div class="grid gap-6 lg:grid-cols-2">
        <div class="grid content-start gap-6 md:grid-cols-2">
            <twig:Card>
                <twig:Card:Header><twig:Card:Title>Bilan</twig:Card:Title></twig:Card:Header>
                <twig:Card:Content>
                    <twig:Table>
                        <twig:Table:Header>
                            <twig:Table:Row>
                                <twig:Table:Head/>
                                <twig:Table:Head class="text-end">{{ dashboard.usdPerFavorite|round(4) }} $</twig:Table:Head>
                                <twig:Table:Head class="text-end">1 {{ fiat }}</twig:Table:Head>
                            </twig:Table:Row>
                        </twig:Table:Header>
                        <twig:Table:Body>
                            {% for label, usd in {'Investi': dashboard.depositUsd, 'Wallet crypto': dashboard.cryptoUsd, 'Wallet stable': dashboard.stableUsd, 'Total': dashboard.totalUsd} %}
                                <twig:Table:Row>
                                    <twig:Table:Cell class="text-muted-foreground">{{ label }}</twig:Table:Cell>
                                    <twig:Table:Cell class="text-end tabular-nums">{{ usd|round|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                    <twig:Table:Cell class="text-end tabular-nums">{{ dashboard.toFavorite(usd)|round|number_format(0, '.', ' ') }} {{ fiat }}</twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                            <twig:Table:Row class="{{ resultatUsd > 0 ? 'text-positive' : 'text-negative' }}">
                                <twig:Table:Cell class="text-muted-foreground">Résultat</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ resultatUsd|round|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ dashboard.toFavorite(resultatUsd)|round|number_format(0, '.', ' ') }} {{ fiat }}</twig:Table:Cell>
                            </twig:Table:Row>
                            <twig:Table:Row>
                                <twig:Table:Cell class="text-muted-foreground">Résultat %</twig:Table:Cell>
                                <twig:Table:Cell colspan="2" class="text-end tabular-nums {{ percent > 0 ? 'text-positive' : 'text-negative' }}">{{ percent|round|number_format(0, '.', ' ') }} %</twig:Table:Cell>
                            </twig:Table:Row>
                            <twig:Table:Row>
                                <twig:Table:Cell class="text-muted-foreground">Total emprunt</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ dashboard.loanUsd|round|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ dashboard.toFavorite(dashboard.loanUsd)|round|number_format(0, '.', ' ') }} {{ fiat }}</twig:Table:Cell>
                            </twig:Table:Row>
                        </twig:Table:Body>
                    </twig:Table>
                </twig:Card:Content>
            </twig:Card>

            <div class="grid content-start gap-6">
                <twig:Card>
                    <twig:Card:Header><twig:Card:Title>Farming</twig:Card:Title></twig:Card:Header>
                    <twig:Card:Content>
                        <twig:Table>
                            <twig:Table:Header>
                                <twig:Table:Row>
                                    <twig:Table:Head/>
                                    <twig:Table:Head class="text-end">{{ dashboard.usdPerFavorite|round(4) }} $</twig:Table:Head>
                                    <twig:Table:Head class="text-end">1 {{ fiat }}</twig:Table:Head>
                                </twig:Table:Row>
                            </twig:Table:Header>
                            <twig:Table:Body>
                                {% for label, divisor in {'Jour': 365, 'Semaine': 52, 'Mois': 12, 'Année': 1} %}
                                    <twig:Table:Row>
                                        <twig:Table:Cell class="text-muted-foreground">{{ label }}</twig:Table:Cell>
                                        <twig:Table:Cell class="text-end tabular-nums">{{ (dashboard.yearFarmingUsd / divisor)|round|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                        <twig:Table:Cell class="text-end tabular-nums">{{ (dashboard.toFavorite(dashboard.yearFarmingUsd) / divisor)|round|number_format(0, '.', ' ') }} {{ fiat }}</twig:Table:Cell>
                                    </twig:Table:Row>
                                {% endfor %}
                            </twig:Table:Body>
                        </twig:Table>
                    </twig:Card:Content>
                </twig:Card>

                <twig:Card>
                    <twig:Card:Header><twig:Card:Title>Wallet crypto</twig:Card:Title></twig:Card:Header>
                    <twig:Card:Content>
                        <twig:Table>
                            <twig:Table:Body>
                                {% for holding in dashboard.cryptoHoldings %}
                                    <twig:Table:Row>
                                        <twig:Table:Cell class="w-8 text-center"><twig:App:CoinLogo url="{{ holding.thumbUrl }}" name="{{ holding.name }}"/></twig:Table:Cell>
                                        <twig:Table:Cell class="text-end tabular-nums">{{ holding.quantity|round(2)|number_format(2, '.', ' ') }}</twig:Table:Cell>
                                        <twig:Table:Cell>{{ holding.symbol|upper }}</twig:Table:Cell>
                                        <twig:Table:Cell class="text-end tabular-nums">{{ holding.valueUsd|round(2)|number_format(2, '.', ' ') }} $</twig:Table:Cell>
                                    </twig:Table:Row>
                                {% endfor %}
                            </twig:Table:Body>
                        </twig:Table>
                    </twig:Card:Content>
                </twig:Card>
            </div>
        </div>

        <div class="grid content-start gap-6">
            {% if dashboard.cryptoHoldings|length > 1 %}
                <twig:Card>
                    <twig:Card:Header><twig:Card:Title>Mes positions</twig:Card:Title></twig:Card:Header>
                    <twig:Card:Content>
                        <div class="relative h-[500px]"><canvas id="chart-pos"></canvas></div>
                    </twig:Card:Content>
                </twig:Card>
            {% endif %}
            <div class="grid gap-6 sm:grid-cols-2">
                <twig:Card>
                    <twig:Card:Header><twig:Card:Title>Ratio Crypto/Stable</twig:Card:Title></twig:Card:Header>
                    <twig:Card:Content><canvas id="chart-ratio"></canvas></twig:Card:Content>
                </twig:Card>
                {% if dashboard.stableHoldings|length > 1 %}
                    <twig:Card>
                        <twig:Card:Header><twig:Card:Title>Mes positions stable</twig:Card:Title></twig:Card:Header>
                        <twig:Card:Content><canvas id="chart-stable"></canvas></twig:Card:Content>
                    </twig:Card>
                {% endif %}
            </div>
        </div>
    </div>

    <div id="id-array-positions" hidden
         data-pie="{{ dashboard.cryptoHoldings|map(h => {libelle: h.name, color: h.color, percent: h.percent})|json_encode }}"
         data-piestable="{{ dashboard.stableHoldings|map(h => {libelle: h.name, color: h.color, percent: h.percent})|json_encode }}"
         data-crypto="{{ dashboard.cryptoUsd }}"
         data-stable="{{ dashboard.stableUsd }}">
    </div>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    <title>{% block title %}CryptoBook{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}"/>

    {# Before any CSS, so the page never flashes in the wrong theme. Kept in sync by theme_controller.js. #}
    <script>
        (() => {
            let theme = null;
            try { theme = localStorage.getItem('theme'); } catch {}
            const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.classList.toggle('dark', dark);
        })();
    </script>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {# A single entrypoint: with Turbo, the importmap cannot change from one page to the next. Page scripts are Stimulus controllers. #}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="min-h-screen font-sans antialiased">
<header class="sticky top-0 z-40 border-b border-border bg-background/70 backdrop-blur-lg">
    <div class="mx-auto flex max-w-[85rem] flex-wrap items-center gap-x-7 px-6 pt-2 lg:pt-0">
        <a class="flex min-h-11 items-center rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/50" href="{{ path('home') }}">
            <twig:App:Logo/>
        </a>
        {% block header_nav %}
            {# Inside the block so error pages (which empty it) skip the menus: security is not available on 404 pages. #}
            {% set main_menu = knp_menu_get('main') %}
            {% if main_menu.children is not empty %}
                <nav class="order-last -mx-1 w-full min-w-0 overflow-x-auto px-1 [scrollbar-width:none] lg:order-none lg:w-auto lg:flex-1" aria-label="Navigation principale">
                    {{ knp_menu_render(main_menu) }}
                </nav>
            {% endif %}
        {% endblock %}
        <div class="ml-auto flex items-center gap-2">
            <twig:App:ThemeToggle/>
            {% block header_account %}
                <twig:Popover>
                    <twig:Popover:Trigger>
                        <twig:Button size="icon-xl" aria-label="Compte" {{ ...popover_trigger_attrs }}>
                            <twig:ux:icon name="lucide:user-round" class="size-4.5"/>
                        </twig:Button>
                    </twig:Popover:Trigger>
                    <twig:Popover:Content align="end" class="w-56 p-1.5" aria-label="Compte">
                        {% if app.user %}
                            <p class="truncate px-2.5 pt-1 pb-1.5 text-xs text-muted-foreground">{{ app.user.userIdentifier }}</p>
                        {% endif %}
                        {{ knp_menu_render('account', {template: 'shared/account_menu.html.twig'}) }}
                    </twig:Popover:Content>
                </twig:Popover>
            {% endblock %}
        </div>
    </div>
</header>

<main class="mx-auto max-w-[85rem] px-6 py-8">
    {% block body %}{% endblock %}
</main>
</body>
</html>

{% extends 'base.html.twig' %}

{% block title %}NFT{% endblock %}

{% block body %}
    <twig:App:PageHeader title="Mes NFT" description="{{ nfts_sold|length > 0 ? 'Résultat : ' ~ total_benef|round(2) ~ ' $' }}">
        <twig:Button as="a" href="{{ path('app_nft_new') }}">
            <twig:ux:icon name="lucide:plus" data-icon="inline-start"/> Ajouter
        </twig:Button>
    </twig:App:PageHeader>

    <twig:App:InfoDialog>
        <twig:Tabs defaultValue="live">
            <twig:Tabs:List>
                <twig:Tabs:Trigger value="live">Live ({{ nfts|length }})</twig:Tabs:Trigger>
                <twig:Tabs:Trigger value="sold">Vendu ({{ nfts_sold|length }})</twig:Tabs:Trigger>
            </twig:Tabs:List>

            <twig:Tabs:Content value="live">
                <twig:Table>
                    <twig:Table:Header>
                        <twig:Table:Row>
                            <twig:Table:Head class="w-10"/>
                            <twig:Table:Head class="text-end">Acheté le</twig:Table:Head>
                            <twig:Table:Head>Collection</twig:Table:Head>
                            <twig:Table:Head>ID</twig:Table:Head>
                            <twig:Table:Head class="text-end">Prix crypto</twig:Table:Head>
                            <twig:Table:Head>Crypto</twig:Table:Head>
                            <twig:Table:Head class="text-end">Prix dollar</twig:Table:Head>
                            <twig:Table:Head class="text-end">Actions</twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>
                    <twig:Table:Body>
                        {% for nft in nfts %}
                            <twig:Table:Row>
                                <twig:Table:Cell><twig:App:InfoButton url="{{ path('app_nft_ajax_infos', {id: nft.id}) }}" title="{{ nft.collection }} #{{ nft.num }}"/></twig:Table:Cell>
                                <twig:Table:Cell class="text-end">{{ nft.purchasedOn ? nft.purchasedOn|date('d/m/Y') }}</twig:Table:Cell>
                                <twig:Table:Cell>{{ nft.collection }}</twig:Table:Cell>
                                <twig:Table:Cell>{{ nft.num }}</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ nft.priceCrypto }}</twig:Table:Cell>
                                <twig:Table:Cell>{{ nft.cryptocurrency.symbol|upper }}</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ nft.priceUsd|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                <twig:Table:Cell class="text-end">
                                    <twig:App:RowActions editUrl="{{ path('app_nft_edit', {id: nft.id}) }}" deleteUrl="{{ path('app_nft_delete', {id: nft.id}) }}" tokenId="delete{{ nft.id }}"/>
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        {% else %}
                            <twig:Table:Row><twig:Table:Cell colspan="8" class="py-6 text-center text-muted-foreground">Aucun NFT.</twig:Table:Cell></twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            </twig:Tabs:Content>

            <twig:Tabs:Content value="sold">
                <twig:Table>
                    <twig:Table:Header>
                        <twig:Table:Row>
                            <twig:Table:Head class="w-10"/>
                            <twig:Table:Head class="text-end">Acheté le</twig:Table:Head>
                            <twig:Table:Head>Collection</twig:Table:Head>
                            <twig:Table:Head class="text-end">Prix d'achat</twig:Table:Head>
                            <twig:Table:Head class="text-end">Vendu le</twig:Table:Head>
                            <twig:Table:Head class="text-end">Prix de vente</twig:Table:Head>
                            <twig:Table:Head class="text-end">Frais</twig:Table:Head>
                            <twig:Table:Head class="text-end">Gains/Pertes</twig:Table:Head>
                            <twig:Table:Head class="text-end">Actions</twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>
                    <twig:Table:Body>
                        {% for nft in nfts_sold %}
                            <twig:Table:Row>
                                <twig:Table:Cell><twig:App:InfoButton url="{{ path('app_nft_ajax_infos', {id: nft.id}) }}" title="{{ nft.collection }} #{{ nft.num }}"/></twig:Table:Cell>
                                <twig:Table:Cell class="text-end">{{ nft.purchasedOn ? nft.purchasedOn|date('d/m/Y') }}</twig:Table:Cell>
                                <twig:Table:Cell>{{ nft.collection }}</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ nft.priceUsd|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                <twig:Table:Cell class="text-end">{{ nft.soldOn ? nft.soldOn|date('d/m/Y') }}</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ nft.priceSoldUsd|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums">{{ nft.percentSaleFees }} %</twig:Table:Cell>
                                <twig:Table:Cell class="text-end tabular-nums {{ nft.benefice > 0 ? 'text-positive' : 'text-negative' }}">{{ nft.benefice|number_format(0, '.', ' ') }} $</twig:Table:Cell>
                                <twig:Table:Cell class="text-end">
                                    <twig:App:RowActions editUrl="{{ path('app_nft_edit', {id: nft.id}) }}" deleteUrl="{{ path('app_nft_delete', {id: nft.id}) }}" tokenId="delete{{ nft.id }}"/>
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        {% else %}
                            <twig:Table:Row><twig:Table:Cell colspan="9" class="py-6 text-center text-muted-foreground">Aucun NFT vendu.</twig:Table:Cell></twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            </twig:Tabs:Content>
        </twig:Tabs>
    </twig:App:InfoDialog>
{% endblock %}

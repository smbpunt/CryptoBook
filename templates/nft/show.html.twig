<div class="grid gap-1 text-sm tabular-nums">
    {% if nft.rank %}<p>Rang : {{ nft.rank|decimal }}</p>{% endif %}
    <p>Supply : {{ nft.supply|decimal }}</p>
    {% if nft.purchasedOn %}<p>Acheté le {{ nft.purchasedOn|day }}</p>{% endif %}
    {% if nft.soldOn %}<p>Vendu le {{ nft.soldOn|day }}</p>{% endif %}
    {% if nft.description is not empty %}<p>Description : {{ nft.description }}</p>{% endif %}
</div>

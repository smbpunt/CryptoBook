{{ form_start(form) }}
    <div class="grid gap-x-4 md:grid-cols-4">
        {{ form_row(form.blockchain, {label: 'Blockchain'}) }}
        {{ form_row(form.cryptocurrency, {label: 'Payé en'}) }}
    </div>
    <div class="grid gap-x-4 md:grid-cols-4">
        {{ form_row(form.collection, {label: 'Collection', attr: {placeholder: 'ex: Aurory'}}) }}
        {{ form_row(form.supply, {label: 'Supply', attr: {placeholder: 'ex: 10 000'}}) }}
        {{ form_row(form.num, {label: '# Id', attr: {placeholder: 'ex: 2130'}}) }}
        {{ form_row(form.rank, {label: 'Classement', attr: {placeholder: 'ex: 120'}}) }}
    </div>
    <div class="grid gap-x-4 md:grid-cols-4">
        {{ form_row(form.purchasedOn, {label: 'Acheté le'}) }}
        {{ form_row(form.priceCrypto, {label: 'Prix en crypto', attr: {placeholder: 'ex: 2'}}) }}
        {{ form_row(form.priceUsd, {label: 'Prix en dollar', addon: '$', attr: {placeholder: 'ex: 250'}}) }}
    </div>
    <div class="grid gap-x-4 md:grid-cols-4">
        {{ form_row(form.soldOn, {label: 'Vendu le'}) }}
        {{ form_row(form.priceSoldCrypto, {label: 'Prix en crypto', attr: {placeholder: 'ex: 10'}}) }}
        {{ form_row(form.priceSoldUsd, {label: 'Prix en dollar', addon: '$', attr: {placeholder: 'ex: 3 000'}}) }}
        {{ form_row(form.percentSaleFees, {label: 'Frais de revente', addon: '%', attr: {placeholder: 'ex: 5'}}) }}
    </div>
    {{ form_row(form.description, {label: 'Description', attr: {placeholder: 'ex: Mon NFT préféré !', rows: 3}}) }}
    <twig:Button type="submit" class="h-11 px-5">{{ button_label|default('Enregistrer') }}</twig:Button>
{{ form_end(form) }}

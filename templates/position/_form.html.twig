{% import _self as formMacros %}

{% macro vente_prototype(vente) %}
    <tr class="border-b">
        <td class="w-12 p-2"><twig:Button variant="outline" size="icon-sm" data-action="collection#remove" aria-label="Retirer"><twig:ux:icon name="lucide:minus"/></twig:Button></td>
        <td class="p-2">{{ form_widget(vente.soldAt) }}{{ form_errors(vente.soldAt) }}</td>
        <td class="p-2">{{ form_widget(vente.percent, {addon: '%'}) }}{{ form_errors(vente.percent) }}</td>
        <td class="p-2">{{ form_widget(vente.priceSold, {addon: '$'}) }}{{ form_errors(vente.priceSold) }}</td>
    </tr>
{% endmacro %}

{% macro strategy_prototype(strategy) %}
    <tr class="border-b">
        <td class="w-12 p-2"><twig:Button variant="outline" size="icon-sm" data-action="collection#remove" aria-label="Retirer"><twig:ux:icon name="lucide:minus"/></twig:Button></td>
        <td class="p-2">{{ form_widget(strategy.percent, {addon: '%'}) }}{{ form_errors(strategy.percent) }}</td>
        <td class="p-2">{{ form_widget(strategy.priceSold, {addon: '$'}) }}{{ form_errors(strategy.priceSold) }}</td>
    </tr>
{% endmacro %}

{{ form_start(form) }}
    <div class="grid gap-x-4 md:grid-cols-4">
        {{ form_row(form.openedAt, {label: 'Date'}) }}
        {{ form_row(form.coin, {label: 'Coin'}) }}
        {{ form_row(form.nbCoins, {label: 'Nombre', attr: {placeholder: 'ex: 0.1'}}) }}
        <twig:Form:Item class="mb-4">
            <div class="flex items-center gap-1.5">
                {{ form_label(form.entryCost, 'Coût total ($)') }}
                <twig:App:HelpTip id="entry-cost-help" text="Coût total payé (pas le coût du coin)"/>
            </div>
            {{ form_widget(form.entryCost, {addon: '$', attr: {placeholder: 'ex: 150'}}) }}
            {{ form_errors(form.entryCost) }}
        </twig:Form:Item>
    </div>
    <div class="flex flex-wrap gap-6">
        {{ form_row(form.isOpened) }}
        {{ form_row(form.isDca) }}
    </div>
    {{ form_row(form.description, {label: 'Description', attr: {placeholder: 'ex: Ma position est sur telle Dapp/Exchange, ou sur la blockchain...', rows: 3}}) }}

    {# Opens on the sales when one of them is invalid. #}
    <twig:Tabs :defaultValue="form.ventes.vars.valid ? 'strategy' : 'vente'" class="mb-4">
        <twig:Tabs:List>
            <twig:Tabs:Trigger value="strategy">Stratégie</twig:Tabs:Trigger>
            <twig:Tabs:Trigger value="vente">Vente</twig:Tabs:Trigger>
        </twig:Tabs:List>
        <twig:Tabs:Content value="strategy">
            {# Component content has its own scope: re-import the macros. #}
            {% import 'position/_form.html.twig' as formMacros %}
            <div data-controller="collection"
                 data-collection-index-value="{{ form.strategies is empty ? 0 : max(form.strategies.children|keys) + 1 }}"
                 data-collection-prototype-value="{{ formMacros.strategy_prototype(form.strategies.vars.prototype)|e('html_attr') }}">
                <twig:Button variant="outline" class="my-2" data-action="collection#add">
                    <twig:ux:icon name="lucide:plus" data-icon="inline-start"/> Ajouter une stratégie
                </twig:Button>
                <table class="w-full max-w-2xl text-sm">
                    <thead class="border-b">
                        <tr><th class="w-12"></th><th class="h-10 px-2 text-start text-xs font-medium text-muted-foreground">%</th><th class="h-10 px-2 text-start text-xs font-medium text-muted-foreground">Prix</th></tr>
                    </thead>
                    <tbody data-collection-target="items">
                    {% for strategy in form.strategies %}
                        {{ formMacros.strategy_prototype(strategy) }}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Tabs:Content>
        <twig:Tabs:Content value="vente">
            {# Component content has its own scope: re-import the macros. #}
            {% import 'position/_form.html.twig' as formMacros %}
            <div data-controller="collection"
                 data-collection-index-value="{{ form.ventes is empty ? 0 : max(form.ventes.children|keys) + 1 }}"
                 data-collection-prototype-value="{{ formMacros.vente_prototype(form.ventes.vars.prototype)|e('html_attr') }}">
                <twig:Button variant="outline" class="my-2" data-action="collection#add">
                    <twig:ux:icon name="lucide:plus" data-icon="inline-start"/> Ajouter une vente
                </twig:Button>
                <table class="w-full max-w-3xl text-sm">
                    <thead class="border-b">
                        <tr><th class="w-12"></th><th class="h-10 px-2 text-start text-xs font-medium text-muted-foreground">Date</th><th class="h-10 px-2 text-start text-xs font-medium text-muted-foreground">%</th><th class="h-10 px-2 text-start text-xs font-medium text-muted-foreground">Prix</th></tr>
                    </thead>
                    <tbody data-collection-target="items">
                    {% for vente in form.ventes %}
                        {{ formMacros.vente_prototype(vente) }}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Tabs:Content>
    </twig:Tabs>

    <div class="flex items-center justify-between gap-2">
        {{ form_widget(form.submit, {label: 'Valider', attr: {class: 'h-11 px-5'}}) }}
        {{ form_widget(form.submitAndNext, {label: 'Valider & continuer', attr: {variant: 'secondary', class: 'h-11 px-5'}}) }}
    </div>
{{ form_end(form) }}

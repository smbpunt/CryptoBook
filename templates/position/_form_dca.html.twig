<div class="grid gap-x-4 md:grid-cols-4">
    {{ form_row(form.openedAt, {label: 'Date'}) }}
    {{ form_row(form.coin, {label: 'Coin'}) }}
    {{ form_row(form.nbCoins, {label: 'Nombre', attr: {placeholder: 'ex: 0.1'}}) }}
    {{ form_row(form.entryCost, {label: 'Coût total ($)', addon: '$', help: 'Coût total payé (pas le coût du coin)', attr: {placeholder: 'ex: 150'}}) }}
</div>

{% set symbol = position.coin.symbol|upper %}
<div class="grid gap-1 text-sm tabular-nums">
    {% if position.openedAt %}<p>Ouverte le {{ position.openedAt|day }}</p>{% endif %}
    <p>Achetés : {{ position.nbCoins|quantity }} {{ symbol }}</p>
    {% if position.remainingCoins != position.nbCoins %}
        <p>Restants : {{ position.remainingCoins|quantity }} {{ symbol }}</p>
    {% endif %}
    <p>Valeur actuelle : {{ position.currentValue|amount('$', 2) }}</p>
    {% if position.description is not empty %}<p>Description : {{ position.description }}</p>{% endif %}
</div>

{% if position.ventesSortedByDate|length > 0 %}
    <h3 class="mt-2 font-display font-semibold">Ventes</h3>
    <twig:Table>
        <twig:Table:Header>
            <twig:Table:Row>
                <twig:Table:Head class="text-end">Vente</twig:Table:Head>
                <twig:Table:Head>Date</twig:Table:Head>
                <twig:Table:Head class="text-end">Part vendue</twig:Table:Head>
                <twig:Table:Head class="text-end">Prix</twig:Table:Head>
            </twig:Table:Row>
        </twig:Table:Header>
        <twig:Table:Body>
            {# loop is not visible inside a component: number the rows with the key. #}
            {% for i, vente in position.ventesSortedByDate %}
                <twig:Table:Row>
                    <twig:Table:Cell class="text-end">{{ i + 1 }}</twig:Table:Cell>
                    <twig:Table:Cell>{{ vente.soldAt ? vente.soldAt|day : '—' }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ vente.percent|percent }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ vente.priceSold|price('$') }}</twig:Table:Cell>
                </twig:Table:Row>
            {% endfor %}
        </twig:Table:Body>
    </twig:Table>
{% endif %}

{% if exitPlan is not null %}
    <h3 class="mt-2 font-display font-semibold">Stratégie</h3>
    <p class="text-sm text-muted-foreground">Ventes prévues : {{ exitPlan.steps|length }}</p>
    <twig:Table>
        <twig:Table:Header>
            <twig:Table:Row>
                <twig:Table:Head class="text-end">Vente</twig:Table:Head>
                <twig:Table:Head class="text-end">Prix</twig:Table:Head>
                <twig:Table:Head class="text-end">Part</twig:Table:Head>
                <twig:Table:Head class="text-end">Vendus</twig:Table:Head>
                <twig:Table:Head class="text-end">Récupéré</twig:Table:Head>
                <twig:Table:Head class="text-end">Restants</twig:Table:Head>
            </twig:Table:Row>
        </twig:Table:Header>
        <twig:Table:Body>
            {% for i, step in exitPlan.steps %}
                <twig:Table:Row>
                    <twig:Table:Cell class="text-end">{{ i + 1 }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ step.sale.priceSold|price('$') }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ step.sale.percent|percent }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ step.soldCoins|quantity }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ step.recoveredUsd|amount('$', 2) }}</twig:Table:Cell>
                    <twig:Table:Cell class="text-end">{{ step.remainingCoins|quantity }}</twig:Table:Cell>
                </twig:Table:Row>
            {% endfor %}
        </twig:Table:Body>
    </twig:Table>
    <h3 class="mt-2 font-display font-semibold">Prévision</h3>
    <div class="grid gap-1 text-sm tabular-nums">
        <p>Restants après les ventes : {{ exitPlan.remainingCoins|quantity }} {{ symbol }} ({{ exitPlan.remainingPercent|percent }})</p>
        <p>Récupéré : {{ exitPlan.recoveredUsd|amount('$') }}</p>
        <p class="{{ exitPlan.resultUsd < 0 ? 'text-negative' : (exitPlan.resultUsd > 0 ? 'text-positive') }}">Résultat : {{ exitPlan.resultUsd|signed_amount('$') }} ({{ exitPlan.resultPercent is null ? '+∞' : exitPlan.resultPercent|signed_percent }})</p>
    </div>
{% endif %}
